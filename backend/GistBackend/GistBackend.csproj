<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.100" />
    <PackageReference Include="Google.Apis.CustomSearchAPI.v1" Version="1.78.0.3520" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.1" />
    <PackageReference Include="MySqlConnector" Version="3.0.0" />
    <PackageReference Include="OpenAI" Version="2.15.0" />
    <PackageReference Include="prometheus-net" Version="8.2.1" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="3.1.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="SharpToken" Version="2.0.6" />
    <PackageReference Include="System.ServiceModel.Syndication" Version="11.0.0" />
    <PackageReference Include="Telegram.Bot" Version="22.10.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Handlers/OpenAIHandler/Resources/**/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
